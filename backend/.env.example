# URBAN backend configuration. Copy to `.env` and fill in as needed.
# All variables are optional; the app boots with safe defaults.

URBAN_ENVIRONMENT=development

# Comma-separated allowed CORS origins (the frontend dev server).
URBAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional LLM key for the AI layer (policy parsing, parliament, media).
# When unset, AI endpoints degrade to a rule-based fallback. Do NOT commit real keys.
URBAN_LLM_API_KEY=
# LLM provider/model used only for language structuring (never numeric effects).
URBAN_LLM_PROVIDER=anthropic
URBAN_LLM_MODEL=claude-3-5-haiku-latest
URBAN_LLM_BASE_URL=https://api.anthropic.com
URBAN_LLM_TIMEOUT_S=20
